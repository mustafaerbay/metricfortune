generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                        String    @id @default(cuid())
  email                     String    @unique
  passwordHash              String
  emailVerified             Boolean   @default(false)
  createdAt                 DateTime  @default(now())
  emailVerificationToken    String?
  emailDigestFrequency      String    @default("weekly")
  emailNotificationsEnabled Boolean   @default(true)
  emailUnsubscribeToken     String?   @unique
  lastDigestSentAt          DateTime?
  timezone                  String    @default("UTC")
  business                  Business?

  @@index([email])
  @@index([emailVerificationToken])
  @@index([emailUnsubscribeToken])
}

model Business {
  id              String           @id @default(cuid())
  userId          String           @unique
  name            String
  industry        String
  revenueRange    String
  productTypes    String[]
  platform        String
  siteId          String           @unique
  peerGroupId     String?
  createdAt       DateTime         @default(now())
  peerGroup       PeerGroup?       @relation(fields: [peerGroupId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  recommendations Recommendation[]
  shopifyStore    ShopifyStore?

  @@index([siteId])
  @@index([industry])
  @@index([revenueRange])
  @@index([industry, revenueRange])
}

model PeerGroup {
  id          String     @id @default(cuid())
  criteria    Json
  businessIds String[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  businesses  Business[]

  @@index([createdAt])
}

model Session {
  id          String   @id @default(cuid())
  siteId      String
  sessionId   String   @unique
  entryPage   String
  exitPage    String?
  duration    Int?
  pageCount   Int
  bounced     Boolean
  converted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  journeyPath String[]

  @@index([siteId, createdAt])
}

model TrackingEvent {
  id        String   @id @default(cuid())
  siteId    String
  sessionId String
  eventType String
  timestamp DateTime
  data      Json
  createdAt DateTime @default(now())

  @@index([siteId, timestamp])
  @@index([sessionId])
  @@map("TrackingEvent")
}

model Pattern {
  id              String   @id @default(cuid())
  siteId          String
  patternType     String
  description     String
  severity        Float
  sessionCount    Int
  confidenceScore Float
  metadata        Json?
  detectedAt      DateTime @default(now())

  @@index([siteId, detectedAt])
  @@index([siteId, severity])
}

model Recommendation {
  id                  String               @id @default(cuid())
  businessId          String
  title               String
  problemStatement    String
  actionSteps         String[]
  expectedImpact      String
  confidenceLevel     ConfidenceLevel
  status              RecommendationStatus @default(NEW)
  impactLevel         ImpactLevel
  peerSuccessData     String?
  implementedAt       DateTime?
  dismissedAt         DateTime?
  createdAt           DateTime             @default(now())
  implementationNotes String?
  business            Business             @relation(fields: [businessId], references: [id])

  @@index([businessId, status])
}

model ShopifyStore {
  id            String         @id @default(cuid())
  businessId    String         @unique
  shopDomain    String         @unique
  accessToken   String
  scriptTagId   String?
  installedAt   DateTime       @default(now())
  uninstalledAt DateTime?
  orders        ShopifyOrder[]
  business      Business       @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([shopDomain])
}

model ShopifyOrder {
  id             String       @id @default(cuid())
  shopifyStoreId String
  shopifyOrderId String       @unique
  orderData      Json
  total          Float
  currency       String
  createdAt      DateTime
  shopifyStore   ShopifyStore @relation(fields: [shopifyStoreId], references: [id])

  @@index([shopifyStoreId])
  @@index([shopifyOrderId])
}

enum RecommendationStatus {
  NEW
  PLANNED
  IMPLEMENTED
  DISMISSED
}

enum ImpactLevel {
  HIGH
  MEDIUM
  LOW
}

enum ConfidenceLevel {
  HIGH
  MEDIUM
  LOW
}
